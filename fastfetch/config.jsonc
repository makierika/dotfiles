    "width": 18,
    "height": 9,
    "padding": {
      "top": 1,
      "left": 0,
      "right": 3
    }
  },
  "display": {
    "percent": {
      "type": 9,
      "color": {
        "green": "#d29066"
      }
    }
  },
  "modules": [
    "break",
    "break",
