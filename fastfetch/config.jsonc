      "keyColor": "#647ba8"
    },
    {
      "type": "packages",
      "format": "{} (pacman)",
      "key": " ",
      "keyColor": "#647ba8"
    },
    {
      "type": "shell",
      "key": " ",
      "keyColor": "#647ba8"
    },
    {
      "type": "terminal",
      "key": " ",
      "keyColor": "#647ba8"
    },
    {
      "type": "wm",
      "key": " ",
      "keyColor": "#647ba8"
    },
    {
