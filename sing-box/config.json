{
  "log": {
    "disabled": true
  },
  "dns": {
    "strategy": "ipv4_only",
    "servers": [
      {
        "tag": "local",
        "type": "hosts",
        "predefined": {
          "thisrdkn4ever.eu.org": "104.20.48.52"
        }
      },
      {
        "tag": "remote",
        "type": "fakeip",
        "inet4_range": "198.18.0.1/16"
      }
    ],
    "rules": [
      {
        "preferred_by": "local",
        "action": "route",
        "server": "local"
      },
      {
        "query_type": [
          "A",
          "AAAA"
        ],
        "server": "remote"
      }
    ]
  },
  "inbounds": [
    {
      "type": "tun",
      "address": "172.19.0.1/30",
      "auto_route": true,
      "strict_route": true
    }
  ],
  "outbounds": [
    {
      "tag": "cfvless",
      "type": "vless",
      "server": "thisrdkn4ever.eu.org",
      "server_port": 443,
      "uuid": "17ecefc4-d24c-4192-b6e4-f8335ee03c8b",
      "network": "tcp",
      "tls": {
        "enabled": true,
        "server_name": "thisrdkn4ever.eu.org",
        "utls": {
          "enabled": true,
          "fingerprint": "chrome"
        }
      },
      "transport": {
        "type": "ws",
        "path": "/?ed=2048",
        "headers": {
          "host": "thisrdkn4ever.eu.org"
        }
      }
    }
  ],
  "route": {
    "rules": [
      {
        "action": "sniff"
      },
      {
        "protocol": "dns",
        "action": "hijack-dns"
      },
      {
        "domain_keyword": [
          "ogads",
          "pagead"
        ],
        "action": "reject"
      }
    ],
    "final": "cfvless",
    "default_domain_resolver": "local",
    "auto_detect_interface": true
  },
  "ntp": {
    "enabled": false
  },
  "experimental": {
    "cache_file": {
      "enabled": true,
      "store_fakeip": true,
      "store_dns": true
    }
  }
}
